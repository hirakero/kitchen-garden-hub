{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kitchen-garden-hub-cc",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitchen-garden-hub",
      "database_id": "238da1de-3f09-4c33-9e52-6715c00eec33",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  "triggers": {
    "crons": ["0 22 * * *"] // UTC 22:00 = JST 7:00
  },

  "vars": {
    "APP_URL": "https://kitchen-garden-hub-cc.hirakero.workers.dev",
    "VAPID_SUBJECT": "mailto:k16.h.white@gmail.com"
  }

  // secrets (set via `wrangler secret put`):
  //   ALLOWED_EMAIL
  //   GOOGLE_CLIENT_ID
  //   GOOGLE_CLIENT_SECRET
  //   BETTER_AUTH_SECRET
  //   VAPID_PUBLIC_KEY
  //   VAPID_PRIVATE_KEY
}
