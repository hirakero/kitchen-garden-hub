{
  "name": "kitchen-garden-hub-cc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kitchen-garden-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply kitchen-garden-hub --remote",
    "db:seed:local": "wrangler d1 execute kitchen-garden-hub --local --file=drizzle/seed.sql",
    "db:seed:remote": "wrangler d1 execute kitchen-garden-hub --remote --file=drizzle/seed.sql",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "better-auth": "^1.6.14",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.23",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260605.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.98.0"
  },
  "overrides": {
    "kysely": "0.28.17"
  }
}
